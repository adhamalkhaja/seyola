#!/usr/bin/env bash
set -euo pipefail

# Seyola Skills — Setup Script
# Installs skills by symlinking into ~/.claude/skills/
# Inspired by gstack's distribution model.
#
# Usage:
#   ./setup                  # Global install (default)
#   ./setup --local          # Project-local install
#   ./setup --prefix         # Namespace as seyola-* (e.g. /seyola-consult)
#   ./setup --no-prefix      # Flat names (e.g. /consult) — default

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SOURCE_DIR="$(cd "$SCRIPT_DIR" && pwd -P)"
VERSION=$(cat "$SOURCE_DIR/VERSION" 2>/dev/null || echo "unknown")

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo ""
echo -e "${CYAN}${BOLD}  ███████╗███████╗██╗   ██╗ ██████╗ ██╗      █████╗${NC}"
echo -e "${CYAN}${BOLD}  ██╔════╝██╔════╝╚██╗ ██╔╝██╔═══██╗██║     ██╔══██╗${NC}"
echo -e "${CYAN}${BOLD}  ███████╗█████╗   ╚████╔╝ ██║   ██║██║     ███████║${NC}"
echo -e "${CYAN}${BOLD}  ╚════██║██╔══╝    ╚██╔╝  ██║   ██║██║     ██╔══██║${NC}"
echo -e "${CYAN}${BOLD}  ███████║███████╗   ██║   ╚██████╔╝███████╗██║  ██║${NC}"
echo -e "${CYAN}${BOLD}  ╚══════╝╚══════╝   ╚═╝    ╚═════╝ ╚══════╝╚═╝  ╚═╝${NC}"
echo ""
echo -e "  ${BOLD}Seyola Skills v${VERSION}${NC}"
echo ""

# --- Parse flags ---

LOCAL_INSTALL=0
SKILL_PREFIX=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --local)    LOCAL_INSTALL=1; shift ;;
    --prefix)   SKILL_PREFIX=1; shift ;;
    --no-prefix) SKILL_PREFIX=0; shift ;;
    *)          echo "Unknown flag: $1"; exit 1 ;;
  esac
done

# --- Determine install directory ---

if [ "$LOCAL_INSTALL" -eq 1 ]; then
  INSTALL_DIR="$(pwd)/.claude/skills"
  echo -e "  ${YELLOW}Installing locally to .claude/skills/${NC}"
else
  INSTALL_DIR="$HOME/.claude/skills"
  echo -e "  ${YELLOW}Installing globally to ~/.claude/skills/${NC}"
fi

mkdir -p "$INSTALL_DIR"

# --- Create state directory ---

SEYOLA_HOME="$HOME/.seyola"
mkdir -p "$SEYOLA_HOME/projects"

# --- Resolve prefix preference ---

CONFIG_BIN="$SOURCE_DIR/bin/seyola-config"

if [ -z "$SKILL_PREFIX" ]; then
  # Check saved config
  SAVED_PREFIX=$("$CONFIG_BIN" get skill_prefix 2>/dev/null || echo "")
  if [ -n "$SAVED_PREFIX" ]; then
    SKILL_PREFIX="$SAVED_PREFIX"
  else
    # Default: flat names (no prefix)
    SKILL_PREFIX=0
  fi
fi

# Save preference
"$CONFIG_BIN" set skill_prefix "$SKILL_PREFIX" 2>/dev/null || true

if [ "$SKILL_PREFIX" -eq 1 ]; then
  PREFIX="seyola-"
  echo -e "  ${YELLOW}Skill prefix: seyola-* (e.g. /seyola-consult)${NC}"
else
  PREFIX=""
  echo -e "  ${YELLOW}Skill prefix: flat names (e.g. /consult)${NC}"
fi

echo ""

# --- Link the seyola root directory ---

SEYOLA_LINK="$INSTALL_DIR/seyola"
if [ -L "$SEYOLA_LINK" ]; then
  rm "$SEYOLA_LINK"
fi
if [ ! -d "$SEYOLA_LINK" ]; then
  ln -s "$SOURCE_DIR" "$SEYOLA_LINK"
fi

# --- Discover and link skills ---

SKILL_COUNT=0

for SKILL_DIR in "$SOURCE_DIR"/skills/*/; do
  [ ! -f "$SKILL_DIR/SKILL.md" ] && continue

  # Extract name from frontmatter or use directory name
  DIR_NAME=$(basename "$SKILL_DIR")
  SKILL_NAME=$(grep -m1 '^name:' "$SKILL_DIR/SKILL.md" 2>/dev/null | sed 's/name: *//' | tr -d '"' | tr -d "'" || echo "$DIR_NAME")
  [ -z "$SKILL_NAME" ] && SKILL_NAME="$DIR_NAME"

  LINK_NAME="${PREFIX}${SKILL_NAME}"
  LINK_PATH="$INSTALL_DIR/$LINK_NAME"

  # Remove existing symlink if pointing to seyola
  if [ -L "$LINK_PATH" ]; then
    EXISTING_TARGET=$(readlink "$LINK_PATH" 2>/dev/null || true)
    if echo "$EXISTING_TARGET" | grep -q "seyola"; then
      rm "$LINK_PATH"
    fi
  fi

  # Create symlink
  if [ ! -e "$LINK_PATH" ]; then
    ln -s "$SKILL_DIR" "$LINK_PATH"
    echo -e "  ${GREEN}✓${NC} /${LINK_NAME}"
    SKILL_COUNT=$((SKILL_COUNT + 1))
  else
    echo -e "  ${YELLOW}⚠${NC} /${LINK_NAME} (already exists, skipped)"
  fi
done

# (upgrade skill now lives in skills/ — discovered automatically above)

echo ""
echo -e "  ${GREEN}${BOLD}Done.${NC} ${SKILL_COUNT} skills linked."
echo ""

# --- Cleanup stale symlinks from opposite prefix mode ---

if [ "$SKILL_PREFIX" -eq 1 ]; then
  # Remove flat-name symlinks pointing to seyola
  for SKILL_DIR in "$SOURCE_DIR"/skills/*/; do
    [ ! -f "$SKILL_DIR/SKILL.md" ] && continue
    DIR_NAME=$(basename "$SKILL_DIR")
    FLAT_LINK="$INSTALL_DIR/$DIR_NAME"
    if [ -L "$FLAT_LINK" ]; then
      TARGET=$(readlink "$FLAT_LINK" 2>/dev/null || true)
      if echo "$TARGET" | grep -q "seyola"; then
        rm "$FLAT_LINK"
        echo -e "  ${YELLOW}cleaned${NC} old flat link: /$DIR_NAME"
      fi
    fi
  done
else
  # Remove prefixed symlinks pointing to seyola
  for SKILL_DIR in "$SOURCE_DIR"/skills/*/; do
    [ ! -f "$SKILL_DIR/SKILL.md" ] && continue
    DIR_NAME=$(basename "$SKILL_DIR")
    PREFIXED_LINK="$INSTALL_DIR/seyola-$DIR_NAME"
    if [ -L "$PREFIXED_LINK" ]; then
      TARGET=$(readlink "$PREFIXED_LINK" 2>/dev/null || true)
      if echo "$TARGET" | grep -q "seyola"; then
        rm "$PREFIXED_LINK"
        echo -e "  ${YELLOW}cleaned${NC} old prefixed link: /seyola-$DIR_NAME"
      fi
    fi
  done
fi

# --- First-time welcome ---

if [ ! -f "$SEYOLA_HOME/.welcome-seen" ]; then
  echo ""
  echo -e "  ${CYAN}Welcome to Seyola Skills.${NC}"
  echo ""
  echo "  Run /seyola-upgrade anytime to check for updates."
  echo "  Run /consult to start your first business diagnostic."
  echo ""
  touch "$SEYOLA_HOME/.welcome-seen"
fi

# --- Save install metadata ---

echo "$VERSION" > "$SEYOLA_HOME/installed-version"
echo "$SOURCE_DIR" > "$SEYOLA_HOME/install-path"
date -u +%Y-%m-%dT%H:%M:%SZ > "$SEYOLA_HOME/install-date"
